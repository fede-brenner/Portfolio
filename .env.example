# Copiar este archivo a .env.local y completar con los valores reales de tu proyecto Supabase.
VUE_APP_SUPABASE_URL=
VUE_APP_SUPABASE_ANON_KEY=
VUE_APP_ALLOWED_EMAIL=

# API key de Google Maps (Places API), restringida por dominio (HTTP referrer).
# Usada para el buscador de Barrio en el formulario de personas.
VUE_APP_GOOGLE_MAPS_API_KEY=
